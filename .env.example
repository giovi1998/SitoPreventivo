# DeepSeek API Key - server-side only
# Ottieni una chiave su https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Google AI (Gemini) API Key - server-side only
# Ottieni una chiave su https://aistudio.google.com/apikey
# Necessaria per generazione background logo AI (Nano Banana 2 Lite: gemini-3.1-flash-lite-image)
# Senza questa key, il tab AI del LogoEditor funziona ma genera solo parametri (no background)
# Funziona sia in locale (Vite proxy tramite api/index.ts) che in produzione (Vercel)
GEMINI_API_KEY=

# Replicate API Key - server-side only (opzionale, deprecato)
# Usato come fallback per Logo AI background. Se GEMINI_API_KEY è presente, ha priorità.
# Ottieni una chiave su https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Ollama Pro Cloud API Key - server-side only (TB-023)
# Piano $20/mo flat, 50x free usage, 3 modelli concorrenti, zero data retention.
# Modelli: minimax-m3:cloud (multimodale Text+Image, sostituto gemini-3-flash-preview
# ritirato 15 luglio 2026), deepseek-v4-pro:cloud, qwen-3.5.
# API https://ollama.com/api/chat, auth Bearer.
# Ottieni una chiave su https://ollama.com/settings/keys (richiede subscription Pro)
OLLAMA_API_KEY=

# Admin password - usata ESCLUSIVAMENTE via env var (Vercel: ADMIN_PASSWORD, locale: VITE_ADMIN_PASSWORD)
# L'admin è sempre admin@gmail.com, la password non viene salvata su database
# Requisiti: minimo 12 caratteri, 1 maiuscola, 1 minuscola, 1 numero, 1 carattere speciale
ADMIN_PASSWORD=

# Stessa password sopra, ma con prefisso VITE_ per accesso client-side (locale)
VITE_ADMIN_PASSWORD=

# Database - Neon / Vercel Postgres connection string (server-side only)
DATABASE_URL=

# Origine autorizzata per CORS in produzione (es. https://tuodominio.vercel.app)
# In dev è sempre '*'. Se vuoto, accetta solo *.vercel.app
ALLOWED_ORIGIN=

# TB-027: feature flag registrazione. Default false (CRM admin-only).
# WHITELABEL: impostare true per riattivare signup pubblico (modalità SaaS).
REGISTRATION_ENABLED=false

# Stesso flag con prefisso VITE_ per accesso client-side (locale dev).
# In prod il frontend legge /api/config (server-side legge REGISTRATION_ENABLED).
VITE_REGISTRATION_ENABLED=false

# TB-027: Firecrawl API key per auto-research clienti (server-side only).
# Sostituisce Google Places. Scraping sito cliente + chunking per RAG.
# Ottieni su https://firecrawl.dev/
FIRECRAWL_API_KEY=

# TB-029: Langfuse observability (server-side only) — tracing AI + costi per cliente.
# Progetto: Settings → API Keys. OTLP endpoint EU: https://cloud.langfuse.com
# (US: https://us.cloud.langfuse.com). Senza chiavi il tracing è no-op.
# Prompt Management: label production (Vercel) vs staging (locale) → template
# diversi per ambiente. Sync: `npm run prompts:sync:prod` / `:staging`.
# In dev Vite espone le var VITE_* al proxy: puoi usare anche quelle.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
