{
  "name": "sitopreventivo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --workers=1",
    "test:e2e:critical": "node scripts/e2e-gate.mjs",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "check:api-imports": "node scripts/check-api-imports.mjs",
    "docs:sync-check": "node scripts/docs-sync-check.mjs",
    "prompts:sync": "tsx scripts/sync-prompts.ts",
    "prompts:sync:staging": "tsx scripts/sync-prompts.ts --label staging",
    "prompts:sync:prod": "tsx scripts/sync-prompts.ts --label production"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.10.0",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.4.1",
    "bcryptjs": "^3.0.3",
    "codemirror": "^6.0.2",
    "docx": "^9.7.1",
    "drizzle-orm": "^1.0.0-beta.22",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.395.0",
    "pdfjs-dist": "^6.0.227",
    "pdfmake": "^0.3.11",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "svg2pdf.js": "^2.7.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.9",
    "drizzle-kit": "^1.0.0-beta.22",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "playwright": "^1.61.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^5.2.0",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "@google/genai": true,
    "core-js": true,
    "esbuild": true,
    "protobufjs": true,
    "tesseract.js": true
  }
}
